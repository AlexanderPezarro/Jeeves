{
  "name": "jeeves-server",
  "version": "0.1.0",
  "private": true,
  "description": "Jeeves control plane: events, rules, plugins and Claude planning runs",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "vapid": "node dist/index.js vapid",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.2.0",
    "croner": "^11.0.0",
    "fastify": "^5.12.8",
    "firebase-admin": "^14.5.1",
    "web-push": "^4.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
