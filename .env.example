# Claude auth. The default "cli" backend uses your Claude subscription: run `claude setup-token`
# on any machine with a browser and paste the token here (valid about a year, no refresh needed).
# Without it the server falls back to the ~/.claude login mounted in docker-compose.yml, which expires.
CLAUDE_CODE_OAUTH_TOKEN=
# Only for JEEVES_CLAUDE_BACKEND=api. Leave empty for "cli": if set, it overrides the OAuth token.
ANTHROPIC_API_KEY=
# Typed into the app once to pair your phone. Use something long and random.
JEEVES_PAIRING_CODE=
# Shared secret between the server and the to-do plugin.
TODO_PLUGIN_TOKEN=
# Shared secret with workout-app (the exercise plugin): same value as its JEEVES_PLUGIN_TOKEN.
EXERCISE_PLUGIN_TOKEN=
# Push (UnifiedPush via ntfy, see docs/deploy.md). Generate once with:
#   docker compose run --rm server node dist/index.js vapid
# and paste the three lines. Without them (and without Firebase) the app polls every 15 minutes.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Only if the server can't reach ntfy at its public name: "from=to", see docs/deploy.md.
# PUSH_ENDPOINT_REWRITE=https://ntfy.alexanderpezarro.uk=http://ntfy:80
# Legacy: path to a Firebase service-account JSON for FCM push. Web Push wins when VAPID is set.
FIREBASE_SERVICE_ACCOUNT=
# Web UI (/admin) behind Caddy + Authelia: trust the Remote-User header only from Caddy.
# JEEVES_TRUSTED_PROXY is a comma list of addresses/CIDRs (Caddy's address on proxy_network).
JEEVES_TRUST_PROXY_AUTH=0
JEEVES_TRUSTED_PROXY=
# Publish the server port on localhost only; Caddy talks to it over proxy_network.
JEEVES_BIND=127.0.0.1
